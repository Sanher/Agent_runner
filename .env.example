# Copy this file to .env for local pilots. Do not commit the real .env.
# The standalone console reads only environment variables and never options.json.
# Set a unique local value before starting the console (not false, none, or null).
JOB_SECRET=
INTAKE_LOCAL_DATA_DIR=./.data/intake_local
INTAKE_LOCAL_HOST=127.0.0.1
INTAKE_LOCAL_PORT=8098

# Discord reader. Keep disabled until the test bot and allow-list are ready.
DISCORD_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_OPENAI_API_KEY=
DISCORD_OPENAI_MODEL=gpt-5-mini
DISCORD_CHANNEL_IDS=
DISCORD_POLL_INTERVAL_MINUTES=15
DISCORD_SUMMARY_MIN_MESSAGES=5
DISCORD_RETENTION_DAYS=14

# Telegram reader configuration for Agent Runner's shared Answers-webhook flow.
# The standalone local console does not start this source or connect to Telegram.
# The single Telegram bot token and webhook secret stay under Answers Agent
# configuration; do not add them to this local .env file.
# The reader intentionally reuses DISCORD_OPENAI_API_KEY and DISCORD_OPENAI_MODEL.
TELEGRAM_READER_ENABLED=false
TELEGRAM_READER_CHAT_IDS=
TELEGRAM_READER_SUMMARY_MIN_MESSAGES=5
TELEGRAM_READER_RETENTION_DAYS=14
